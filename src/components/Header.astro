---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { nav, site } from '@/site.config';
import { href } from '@/lib/url';

const path = Astro.url.pathname;
// Highlight only the most specific nav item that matches the current page.
const activeHref = nav
  .map((n) => n.href)
  .filter((h) => h !== '/' && path.startsWith(href(h)))
  .sort((a, b) => b.length - a.length)[0];
const isActive = (h: string) => h === activeHref;
---

<header class="site-header" data-header>
  <div class="container flex h-[72px] items-center justify-between gap-4">
    <a href={href('/')} class="flex items-center gap-2.5 no-underline" aria-label={`${site.name} home`}>
      <Logo />
    </a>

    <nav aria-label="Main" class="hidden items-center gap-0.5 xl:flex">
      {
        nav.map((item) => (
          <a href={href(item.href)} class="nav-link" aria-current={isActive(item.href) ? 'page' : undefined}>
            {'short' in item ? item.short : item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <button
        type="button"
        class="hidden h-10 items-center gap-2 rounded-full border border-line bg-card px-3.5 text-[14px] text-muted transition hover:border-ink-2 hover:text-ink xl:inline-flex"
        data-search-open
        aria-label="Search the hub"
      >
        <Icon name="search" size={16} />
        <span>Search</span>
        <kbd class="ml-2 hidden 2xl:inline">Ctrl K</kbd>
      </button>
      <button
        type="button"
        class="grid h-10 w-10 place-items-center rounded-full border border-line bg-card xl:hidden"
        data-search-open
        aria-label="Search the hub"
      >
        <Icon name="search" size={18} />
      </button>
      <button
        type="button"
        class="grid h-10 w-10 place-items-center rounded-full border border-line bg-card text-ink-2 transition hover:text-ink"
        data-theme-toggle
        aria-label="Switch colour theme"
      >
        <Icon name="moon" size={17} class="theme-icon-moon" />
        <Icon name="sun" size={17} class="theme-icon-sun hidden" />
      </button>
      <a href={href('/tools/audit-readiness/')} class="btn btn-primary btn-sm hidden whitespace-nowrap sm:inline-flex">
        Readiness check <Icon name="arrow-right" size={16} class="arrow" />
      </a>
      <button
        type="button"
        class="grid h-10 w-10 place-items-center rounded-full bg-ink text-paper xl:hidden"
        data-menu-open
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
      >
        <Icon name="menu" size={18} />
      </button>
    </div>
  </div>
</header>

<div id="mobile-nav" class="mobile-nav xl:hidden" data-mobile-nav data-open="false" aria-hidden="true">
  <button
    type="button"
    class="absolute right-5 top-4 grid h-11 w-11 place-items-center rounded-full bg-ink text-paper"
    data-menu-close
    aria-label="Close menu"
  >
    <Icon name="x" size={18} />
  </button>
  <nav aria-label="Mobile" class="flex flex-col">
    {
      [{ label: 'Home', href: '/' }, ...nav, { label: 'FAQ', href: '/faq/' }, { label: 'About', href: '/about/' }].map((item) => (
        <a
          href={href(item.href)}
          class="flex items-center justify-between border-b border-line py-4 font-display text-2xl font-semibold no-underline"
        >
          {item.label}
          <Icon name="arrow-right" size={20} class="text-teal" />
        </a>
      ))
    }
  </nav>
  <a href={href('/tools/audit-readiness/')} class="btn btn-primary mt-8 w-full">
    Take the readiness check <Icon name="arrow-right" size={16} class="arrow" />
  </a>
</div>
