---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import AdSlot from '@/components/AdSlot.astro';
import { glossary } from '@/data/glossary';
import { href } from '@/lib/url';
import { definedTermSet } from '@/lib/schema';

const terms = [...glossary].sort((a, b) => a.term.localeCompare(b.term));
const letters = [...new Set(terms.map((t) => t.term[0].toUpperCase()))];
const origin = (Astro.site?.toString() || '').replace(/\/$/, '');
---

<Base
  title="Supported housing glossary"
  description="Plain-English definitions of the terms used in supported exempt accommodation, from care support or supervision to intensive housing management and licensing."
  jsonLd={[definedTermSet(origin, terms)]}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Glossary', url: '/glossary/' },
  ]}
>
  <PageHero
    eyebrow={`${terms.length} terms`}
    title="Supported housing glossary"
    lede="One-sentence definitions first, with a page for each term and links to the guide that covers it in detail."
    crumbs={[
      { name: 'Home', url: '/' },
      { name: 'Glossary', url: '/glossary/' },
    ]}
  >
    <div class="reveal mt-8 flex flex-wrap gap-1.5" style="--i:3">
      {
        letters.map((l) => (
          <a href={`#letter-${l}`} class="grid h-9 w-9 place-items-center rounded-lg border border-line bg-card font-semibold no-underline transition hover:bg-ink hover:text-paper">
            {l}
          </a>
        ))
      }
    </div>
  </PageHero>

  <div class="container">
    <div class="grid gap-x-10 gap-y-2 md:grid-cols-2">
      {
        letters.map((l) => (
          <section id={`letter-${l}`} class="scroll-mt-28 md:col-span-2" aria-label={`Terms starting with ${l}`}>
            <h2 class="mt-10 border-b border-line pb-3 text-[1.6rem] text-teal">{l}</h2>
            <div class="grid gap-4 pt-5 md:grid-cols-2">
              {terms
                .filter((t) => t.term[0].toUpperCase() === l)
                .map((t) => (
                  <a href={href(`/glossary/${t.slug}/`)} class="card card-link block p-5">
                    <h3 class="flex items-start justify-between gap-3 font-display text-[1.15rem] font-semibold">
                      {t.term}
                      <Icon name="arrow-up-right" size={17} class="card-arrow mt-1 shrink-0 text-muted" />
                    </h3>
                    <p class="mt-2 text-[15px] leading-relaxed text-muted">{t.short}</p>
                  </a>
                ))}
            </div>
          </section>
        ))
      }
    </div>
    <AdSlot name="leaderboard" class="mt-16" />
  </div>
</Base>
