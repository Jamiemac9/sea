---
interface Props {
  size?: number;
  class?: string;
}
const { size = 34, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 40 40"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  aria-hidden="true"
>
  <rect width="40" height="40" rx="12" fill="#0B1F24"></rect>
  <path d="M10 19.5 20 11l10 8.5V29a1.5 1.5 0 0 1-1.5 1.5h-17A1.5 1.5 0 0 1 10 29Z" stroke="#C9F2DF" stroke-width="2.4" stroke-linejoin="round"></path>
  <path d="M15 30.5v-4.5a5 5 0 0 1 10 0v4.5" stroke="#3FD1AD" stroke-width="2.4" stroke-linecap="round"></path>
  <circle cx="20" cy="20.5" r="2.6" fill="#D8F59A"></circle>
</svg>
