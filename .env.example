# Copy to .env for local builds. In Cloudflare Pages, set these under
# Settings > Environment variables instead.

# Public origin used for canonicals, the sitemap and structured data.
SITE_URL=https://hub.seaaudit.com

# Advertising. Leave empty to show SEA Audit house ads in every slot.
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_SLOT_LEADERBOARD=
PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
PUBLIC_ADSENSE_SLOT_SIDEBAR=
PUBLIC_ADSENSE_SLOT_FOOTER=
# builtin (the hub's own banner) or external (a Google-certified CMP)
PUBLIC_CONSENT_MODE=builtin

# Optional analytics, loaded only after consent.
PUBLIC_GA4_ID=

# Optional webhook that receives readiness check results as JSON.
PUBLIC_LEAD_ENDPOINT=

# SEA Audit links and contact details.
PUBLIC_AUDIT_URL=https://seaaudit.com
PUBLIC_AUDIT_BOOK_PATH=/
PUBLIC_CONTACT_EMAIL=hello@seaaudit.com
