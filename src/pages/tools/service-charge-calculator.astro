---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import AdSlot from '@/components/AdSlot.astro';
import AuditCta from '@/components/AuditCta.astro';
import { href } from '@/lib/url';

type Line = { label: string; type: 'eligible' | 'ineligible' | 'check'; note: string; amount: number };
const lines: Line[] = [
  { label: 'Core rent', type: 'eligible', note: 'Property costs, lease or loan, insurance, major repairs, voids and bad debt allowance.', amount: 120 },
  { label: 'Cleaning of communal areas', type: 'eligible', note: 'Hallways, kitchens and bathrooms that residents share.', amount: 12 },
  { label: 'Heating, lighting and hot water in communal areas', type: 'eligible', note: 'Only the shared parts of the building.', amount: 9 },
  { label: 'Furniture and household equipment', type: 'eligible', note: 'Provided with the room, including repair and replacement.', amount: 8 },
  { label: 'Communal TV aerial, door entry and laundry facilities', type: 'eligible', note: 'Facilities, not a personal laundry service.', amount: 4 },
  { label: 'Intensive housing management', type: 'check', note: 'Eligible if it is housing management, not support, and backed by time records.', amount: 45 },
  { label: "Fuel for the resident's own room", type: 'ineligible', note: 'Councils apply fixed deductions if it is included without a separate figure.', amount: 15 },
  { label: 'Water charges', type: 'ineligible', note: 'Never eligible for Housing Benefit.', amount: 6 },
  { label: 'Meals', type: 'ineligible', note: 'Fixed deductions apply where meals are included in the charge.', amount: 0 },
  { label: 'Support, counselling or key work', type: 'ineligible', note: 'Paid by a commissioner or the provider, never by Housing Benefit.', amount: 0 },
  { label: "Cleaning of the resident's own room", type: 'check', note: 'Only eligible where nobody in the household can do it.', amount: 0 },
];
const origin = (Astro.site?.toString() || '').replace(/\/$/, '');
const ld = {
  '@type': 'WebApplication',
  name: 'Supported housing service charge calculator',
  url: `${origin}${href('/tools/service-charge-calculator/')}`,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Any',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'GBP' },
};
const typeLabel = { eligible: 'Eligible', ineligible: 'Ineligible', check: 'Depends' };
---

<Base
  title="Supported housing service charge calculator"
  description="Split a weekly supported housing charge into lines eligible and ineligible for Housing Benefit, see the totals, and copy a breakdown to share with your council."
  jsonLd={[ld]}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools/' },
    { name: 'Service charge calculator', url: '/tools/service-charge-calculator/' },
  ]}
>
  <PageHero
    eyebrow="Free tool"
    title="Service charge calculator"
    lede="Enter weekly amounts for each line. The calculator separates what Housing Benefit can cover from what it cannot, and flags the lines that depend on your evidence. The figures shown are an example. Replace them with yours."
    crumbs={[
      { name: 'Home', url: '/' },
      { name: 'Tools', url: '/tools/' },
      { name: 'Service charge calculator', url: '/tools/service-charge-calculator/' },
    ]}
  />

  <div class="container grid gap-10 lg:grid-cols-[minmax(0,1fr)_340px]">
    <div class="min-w-0">
      <form class="card overflow-hidden" data-calc>
        <div class="hidden grid-cols-[1fr_120px_130px] gap-4 border-b border-line bg-paper-2 px-6 py-3 text-[13px] font-semibold uppercase tracking-[0.06em] text-muted md:grid">
          <span>Charge</span><span>Type</span><span class="text-right">£ per week</span>
        </div>
        <ul data-lines>
          {
            lines.map((l, i) => (
              <li class="grid gap-3 border-b border-line px-6 py-4 md:grid-cols-[1fr_120px_130px] md:items-center md:gap-4" data-line>
                <div>
                  <label for={`amt-${i}`} class="font-medium text-ink">{l.label}</label>
                  <p class="mt-0.5 text-[13.5px] text-muted">{l.note}</p>
                </div>
                <select class="field !min-h-[40px] !py-1.5 text-[14px]" data-type aria-label={`Type for ${l.label}`}>
                  {(['eligible', 'check', 'ineligible'] as const).map((t) => (
                    <option value={t} selected={t === l.type}>
                      {typeLabel[t]}
                    </option>
                  ))}
                </select>
                <div class="relative">
                  <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-muted">£</span>
                  <input id={`amt-${i}`} class="field !pl-7 text-right tabular-nums" type="number" min="0" step="0.01" inputmode="decimal" value={l.amount.toFixed(2)} data-amount data-label={l.label} />
                </div>
              </li>
            ))
          }
        </ul>
        <div class="flex flex-wrap gap-3 px-6 py-4">
          <button type="button" class="btn btn-ghost btn-sm" data-add><Icon name="plus" size={15} /> Add a line</button>
          <button type="button" class="btn btn-ghost btn-sm" data-clear>Clear amounts</button>
        </div>
      </form>

      <template data-line-template>
        <li class="grid gap-3 border-b border-line px-6 py-4 md:grid-cols-[1fr_120px_130px] md:items-center md:gap-4" data-line>
          <input class="field" placeholder="Describe the charge" data-custom-label aria-label="Charge description" />
          <select class="field !min-h-[40px] !py-1.5 text-[14px]" data-type aria-label="Type">
            <option value="eligible">Eligible</option>
            <option value="check" selected>Depends</option>
            <option value="ineligible">Ineligible</option>
          </select>
          <div class="relative">
            <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-muted">£</span>
            <input class="field !pl-7 text-right tabular-nums" type="number" min="0" step="0.01" inputmode="decimal" value="0.00" data-amount aria-label="Amount per week" />
          </div>
        </li>
      </template>

      <div class="mt-12">
        <AuditCta
          title="Want your breakdown checked line by line?"
          text="SEA Audit reviews rent and service charge schedules against the eligibility rules and the evidence behind each line, and tells you what a council is likely to challenge."
          campaign="calculator"
        />
      </div>
    </div>

    <aside>
      <div class="sticky top-24 space-y-6">
        <div class="card p-6" aria-live="polite">
          <p class="text-[12px] font-semibold uppercase tracking-[0.08em] text-muted">Weekly summary</p>
          <dl class="mt-4 space-y-3 text-[15px]">
            <div class="flex justify-between"><dt>Total charge</dt><dd class="font-semibold tabular-nums" data-total>£0.00</dd></div>
            <div class="flex justify-between"><dt class="text-teal">Eligible</dt><dd class="font-semibold tabular-nums text-teal" data-eligible>£0.00</dd></div>
            <div class="flex justify-between"><dt class="text-[#8a5300]">Depends on evidence</dt><dd class="font-semibold tabular-nums text-[#8a5300]" data-check>£0.00</dd></div>
            <div class="flex justify-between"><dt class="text-coral">Ineligible</dt><dd class="font-semibold tabular-nums text-coral" data-ineligible>£0.00</dd></div>
          </dl>
          <div class="mt-5 flex h-3 overflow-hidden rounded-full bg-paper-2" aria-hidden="true">
            <span class="h-full bg-teal transition-all duration-500" data-bar-eligible></span>
            <span class="h-full bg-sun transition-all duration-500" data-bar-check></span>
            <span class="h-full bg-coral transition-all duration-500" data-bar-ineligible></span>
          </div>
          <p class="mt-4 text-[14px] text-ink-2" data-annual></p>
          <p class="mt-3 text-[13.5px] text-muted" data-warning></p>
          <div class="mt-5 flex flex-wrap gap-2">
            <button type="button" class="btn btn-dark btn-sm" data-copy-csv>Copy as CSV</button>
            <button type="button" class="btn btn-ghost btn-sm" onclick="window.print()">Print</button>
          </div>
        </div>
        <div class="hidden lg:block"><AdSlot name="sidebar" /></div>
      </div>
    </aside>
  </div>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-calc]')!;
  const list = form.querySelector<HTMLUListElement>('[data-lines]')!;
  const tpl = document.querySelector<HTMLTemplateElement>('[data-line-template]')!;
  const fmt = (n: number) => n.toLocaleString('en-GB', { style: 'currency', currency: 'GBP' });

  const rows = () =>
    Array.from(list.querySelectorAll<HTMLElement>('[data-line]')).map((li) => {
      const amount = Number(li.querySelector<HTMLInputElement>('[data-amount]')!.value) || 0;
      const type = li.querySelector<HTMLSelectElement>('[data-type]')!.value as 'eligible' | 'check' | 'ineligible';
      const custom = li.querySelector<HTMLInputElement>('[data-custom-label]');
      const label = custom ? custom.value || 'Other charge' : li.querySelector<HTMLInputElement>('[data-amount]')!.dataset.label || '';
      return { label, type, amount: Math.max(0, amount) };
    });

  const update = () => {
    const r = rows();
    const sum = (t: string) => r.filter((x) => x.type === t).reduce((n, x) => n + x.amount, 0);
    const eligible = sum('eligible');
    const check = sum('check');
    const ineligible = sum('ineligible');
    const total = eligible + check + ineligible;
    const set = (sel: string, v: number) => (document.querySelector(sel)!.textContent = fmt(v));
    set('[data-total]', total);
    set('[data-eligible]', eligible);
    set('[data-check]', check);
    set('[data-ineligible]', ineligible);
    const pct = (v: number) => (total ? `${(v / total) * 100}%` : '0%');
    document.querySelector<HTMLElement>('[data-bar-eligible]')!.style.width = pct(eligible);
    document.querySelector<HTMLElement>('[data-bar-check]')!.style.width = pct(check);
    document.querySelector<HTMLElement>('[data-bar-ineligible]')!.style.width = pct(ineligible);
    document.querySelector('[data-annual]')!.textContent = total
      ? `Over a year that is ${fmt(total * 52)}, of which up to ${fmt((eligible + check) * 52)} could be met by Housing Benefit if the evidence holds.`
      : '';
    const ihm = r.find((x) => /intensive housing management/i.test(x.label));
    const core = r.find((x) => /core rent/i.test(x.label));
    document.querySelector('[data-warning]')!.textContent =
      ihm && core && ihm.amount > core.amount * 0.5
        ? 'Intensive housing management is more than half the core rent. Councils will expect time records and a clear split from support.'
        : check > 0
          ? 'Lines marked "Depends" need evidence before you count them as eligible.'
          : '';
  };

  form.addEventListener('input', update);
  form.addEventListener('change', update);
  form.querySelector('[data-add]')!.addEventListener('click', () => {
    list.appendChild(tpl.content.cloneNode(true));
    list.lastElementChild?.querySelector<HTMLInputElement>('[data-custom-label]')?.focus();
  });
  form.querySelector('[data-clear]')!.addEventListener('click', () => {
    list.querySelectorAll<HTMLInputElement>('[data-amount]').forEach((i) => (i.value = '0.00'));
    update();
  });
  document.querySelector('[data-copy-csv]')!.addEventListener('click', async (e) => {
    const r = rows();
    const csv = ['Charge,Type,Weekly (GBP)', ...r.map((x) => `"${x.label.replace(/"/g, '""')}",${x.type},${x.amount.toFixed(2)}`)].join('\n');
    const btn = e.currentTarget as HTMLButtonElement;
    try {
      await navigator.clipboard.writeText(csv);
      btn.textContent = 'Copied';
    } catch {
      btn.textContent = 'Copy failed';
    }
    setTimeout(() => (btn.textContent = 'Copy as CSV'), 1600);
  });
  update();
</script>
