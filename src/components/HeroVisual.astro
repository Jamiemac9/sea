---
/**
 * Hero illustration: a resident's route from crisis to a settled home, with
 * the four exempt accommodation tests ticking off on a floating card.
 * Pure SVG and CSS. Motion stops under prefers-reduced-motion.
 */
const tests = ['Landlord is a not-for-profit body', 'Care, support or supervision', 'Provided by the landlord or for it', 'More than minimal'];
---

<div class="relative mx-auto aspect-[1/1] w-full max-w-[560px]" aria-hidden="true">
  <!-- Route map -->
  <svg viewBox="0 0 560 560" class="absolute inset-0 h-full w-full">
    <defs>
      <linearGradient id="route" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="var(--teal)"></stop>
        <stop offset="1" stop-color="#CFA759"></stop>
      </linearGradient>
      <radialGradient id="glow" cx="0.5" cy="0.5" r="0.5">
        <stop offset="0" stop-color="var(--mint)" stop-opacity="0.9"></stop>
        <stop offset="1" stop-color="var(--mint)" stop-opacity="0"></stop>
      </radialGradient>
    </defs>
    <circle cx="300" cy="270" r="250" fill="url(#glow)"></circle>
    <circle cx="300" cy="270" r="200" fill="none" stroke="var(--line-2)" stroke-dasharray="2 9"></circle>
    <circle cx="300" cy="270" r="140" fill="none" stroke="var(--line)" stroke-dasharray="2 9"></circle>
    <path
      id="journey"
      d="M60 470 C 140 470, 150 360, 230 350 S 330 300, 350 220 S 450 120, 500 90"
      fill="none"
      stroke="var(--line-2)"
      stroke-width="10"
      stroke-linecap="round"></path>
    <path
      d="M60 470 C 140 470, 150 360, 230 350 S 330 300, 350 220 S 450 120, 500 90"
      fill="none"
      stroke="url(#route)"
      stroke-width="3"
      stroke-linecap="round"
      class="path-flow"></path>
    <g font-family="var(--font-sans)" font-size="13" font-weight="600" fill="var(--ink-2)">
      <g transform="translate(60 470)">
        <circle r="16" fill="var(--paper)" stroke="var(--coral)" stroke-width="3"></circle>
        <circle r="6" fill="var(--coral)" class="pulse-dot"></circle>
        <circle r="6" fill="var(--coral)"></circle>
        <text x="-6" y="40">Crisis</text>
      </g>
      <g transform="translate(230 350)">
        <circle r="14" fill="var(--paper)" stroke="var(--sun)" stroke-width="3"></circle>
        <circle r="5" fill="var(--sun)"></circle>
        <text x="-38" y="38">Emergency</text>
      </g>
      <g transform="translate(350 220)">
        <circle r="14" fill="var(--paper)" stroke="var(--teal)" stroke-width="3"></circle>
        <circle r="5" fill="var(--teal)"></circle>
        <text x="22" y="5">Supported</text>
      </g>
      <g transform="translate(500 90)">
        <circle r="18" fill="var(--teal)"></circle>
        <path d="M-7 1 L0 -6 L7 1 V8 H-7 Z" fill="#E2BD6F"></path>
        <text x="-52" y="-30">Settled home</text>
      </g>
    </g>
    <circle r="7" fill="#E2BD6F" stroke="var(--teal)" stroke-width="3" class="motion-dot">
      <animateMotion dur="9s" repeatCount="indefinite" rotate="auto" keyPoints="0;1" keyTimes="0;1" calcMode="spline" keySplines="0.45 0 0.25 1">
        <mpath href="#journey"></mpath>
      </animateMotion>
    </circle>
  </svg>

  <!-- Floating test card -->
  <div class="card float absolute left-0 top-[6%] w-[64%] max-w-[300px] p-4 md:p-5">
    <p class="text-[11.5px] font-semibold uppercase tracking-[0.08em] text-muted">Exempt accommodation check</p>
    <ul class="mt-3 space-y-2.5">
      {
        tests.map((t, i) => (
          <li class="flex items-center gap-2.5 text-[13.5px] font-medium text-ink">
            <span class="grid h-5 w-5 shrink-0 place-items-center rounded-full bg-mint">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--teal)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 6 9 17l-5-5" class="tick-draw" style={`animation-delay:${0.6 + i * 0.45}s`} />
              </svg>
            </span>
            {t}
          </li>
        ))
      }
    </ul>
    <div class="mt-4 flex items-center justify-between rounded-xl bg-paper-2 px-3 py-2 text-[12.5px]">
      <span class="text-muted">Likely category</span>
      <span class="font-semibold text-teal">Category 1</span>
    </div>
  </div>

  <!-- Chips -->
  <div class="float float-delay absolute bottom-[18%] right-0 flex items-center gap-2 rounded-2xl border border-line bg-card px-3.5 py-2.5 shadow-[var(--shadow)]">
    <span class="grid h-8 w-8 place-items-center rounded-xl bg-sun-soft text-[#8a5300]">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18"></path></svg>
    </span>
    <span class="text-[13px] leading-tight"><span class="block font-semibold text-ink">Licensing</span><span class="text-muted">expected 2027</span></span>
  </div>
  <div class="float absolute bottom-[4%] left-[22%] flex items-center gap-2 rounded-2xl border border-line bg-card px-3.5 py-2.5 shadow-[var(--shadow)]" style="animation-delay:-2s">
    <span class="grid h-8 w-8 place-items-center rounded-xl bg-mint text-teal">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg>
    </span>
    <span class="text-[13px] leading-tight"><span class="block font-semibold text-ink">Needs assessment</span><span class="text-muted">within 4 weeks</span></span>
  </div>
</div>

<style>
  @media (prefers-reduced-motion: reduce) {
    .motion-dot {
      display: none;
    }
  }
  .bg-sun-soft {
    background: var(--sun-soft);
  }
</style>
