---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import AdSlot from '@/components/AdSlot.astro';
import { resources } from '@/data/resources';
import { href } from '@/lib/url';

const types = ['Legislation', 'Guidance', 'Research', 'Sector body', 'Tool'] as const;
const origin = (Astro.site?.toString() || '').replace(/\/$/, '');
const ld = {
  '@type': 'CollectionPage',
  name: 'Supported housing resources',
  url: `${origin}${href('/resources/')}`,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: resources.map((r, i) => ({ '@type': 'ListItem', position: i + 1, url: r.url, name: r.title })),
  },
};
---

<Base
  title="Supported housing resources and links"
  description="Legislation, official guidance, research and sector bodies for supported exempt accommodation in England, with a line on why each is worth reading."
  jsonLd={[ld]}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Resources', url: '/resources/' },
  ]}
>
  <PageHero
    eyebrow={`${resources.length} resources`}
    title="Resources worth bookmarking"
    lede="Primary sources first: the legislation and official guidance. Then the research and sector bodies we rely on, each with a line on why it is useful."
    crumbs={[
      { name: 'Home', url: '/' },
      { name: 'Resources', url: '/resources/' },
    ]}
  >
    <div class="reveal mt-8 flex flex-wrap gap-2" role="group" aria-label="Filter resources" data-filter style="--i:3">
      <button type="button" class="chip !bg-ink !text-paper" data-filter-btn="all" aria-pressed="true">All</button>
      {
        types.map((t) => (
          <button type="button" class="chip chip-ink" data-filter-btn={t} aria-pressed="false">
            {t}
          </button>
        ))
      }
    </div>
  </PageHero>

  <div class="container">
    {
      types.map((t) => (
        <section class="mb-14" data-filter-group={t} aria-labelledby={`h-${t.replace(/\s/g, '-')}`}>
          <h2 id={`h-${t.replace(/\s/g, '-')}`} class="border-b border-line pb-3 text-[1.7rem]">
            {t}
          </h2>
          <ul class="mt-6 grid gap-4 md:grid-cols-2">
            {resources
              .filter((r) => r.type === t)
              .map((r) => (
                <li>
                  <a href={r.url} target="_blank" rel="noopener" class="card card-link flex h-full flex-col p-5">
                    <span class="flex items-start justify-between gap-3">
                      <span class="font-display text-[1.1rem] font-semibold leading-snug">{r.title}</span>
                      <Icon name="external" size={16} class="card-arrow mt-1 shrink-0 text-muted" />
                    </span>
                    <span class="mt-1 text-[13.5px] font-medium text-teal">{r.publisher}</span>
                    <span class="mt-3 text-[14.5px] leading-relaxed text-muted">{r.why}</span>
                    <span class="mt-auto flex flex-wrap gap-1.5 pt-4">
                      {r.topics.map((tp) => (
                        <span class="chip chip-ink !py-0.5 !text-[12px]">{tp}</span>
                      ))}
                    </span>
                  </a>
                </li>
              ))}
          </ul>
        </section>
      ))
    }
    <AdSlot name="leaderboard" />
  </div>
</Base>

<script>
  const wrap = document.querySelector('[data-filter]');
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter-btn]'));
  const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-filter-group]'));
  wrap?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter-btn]');
    if (!btn) return;
    const value = btn.dataset.filterBtn;
    buttons.forEach((b) => {
      const on = b === btn;
      b.setAttribute('aria-pressed', String(on));
      b.classList.toggle('!bg-ink', on);
      b.classList.toggle('!text-paper', on);
    });
    groups.forEach((g) => (g.hidden = value !== 'all' && g.dataset.filterGroup !== value));
  });
</script>
