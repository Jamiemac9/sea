# Copy to .env for local builds. In Cloudflare Pages, set these under
# Settings > Environment variables instead.

# Public origin used for canonicals, the sitemap and structured data.
SITE_URL=https://exemptaccommodation.com

# Advertising. Leave empty to show SEA Audit house ads in every slot.
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_SLOT_LEADERBOARD=
PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
PUBLIC_ADSENSE_SLOT_SIDEBAR=
PUBLIC_ADSENSE_SLOT_FOOTER=
# builtin (the hub's own banner) or external (a Google-certified CMP)
PUBLIC_CONSENT_MODE=builtin

# Optional analytics, loaded only after consent.
PUBLIC_GA4_ID=

# Search engine verification (content value of the meta tag only).
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=

# Optional webhook that receives readiness check results as JSON.
# Set to /api/subscribe to send them through the sign-up function.
PUBLIC_LEAD_ENDPOINT=

# Where template downloads and alert sign-ups post. Default /api/subscribe.
PUBLIC_SUBSCRIBE_ENDPOINT=

# Sign-up function settings (functions/api/subscribe.ts). In Cloudflare Pages
# set these as runtime variables and secrets, not build variables.
# EMAIL_PROVIDER=brevo
# EMAIL_API_KEY=
# EMAIL_LIST_DOWNLOADS=
# EMAIL_LIST_ALERTS=
# EMAIL_LIST_AUDIT=
# BREVO_DOI_TEMPLATE_ID=
# BREVO_DOI_REDIRECT_URL=https://exemptaccommodation.com/thanks/
# LEAD_WEBHOOK_URL=
# LEAD_WEBHOOK_SECRET=
# ALLOWED_ORIGINS=

# SEA Audit links and contact details.
PUBLIC_AUDIT_URL=https://seaaudit.com
PUBLIC_AUDIT_BOOK_PATH=/
PUBLIC_CONTACT_EMAIL=hello@seaaudit.com
