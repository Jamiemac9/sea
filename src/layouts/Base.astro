---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SearchDialog from '@/components/SearchDialog.astro';
import ConsentBanner from '@/components/ConsentBanner.astro';
import { site, ads, analytics } from '@/site.config';
import { href } from '@/lib/url';
import { graph, organization, website, breadcrumbs as crumbs } from '@/lib/schema';

interface Props {
  title: string;
  description: string;
  /** Full <title>. Defaults to "title | SEA Hub". */
  fullTitle?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  breadcrumbs?: { name: string; url: string }[];
  noindex?: boolean;
  showFooterAd?: boolean;
  published?: Date;
  updated?: Date;
}

const {
  title,
  description,
  fullTitle,
  ogType = 'website',
  jsonLd = [],
  breadcrumbs,
  noindex = false,
  showFooterAd = true,
  published,
  updated,
} = Astro.props;

const origin = (Astro.site?.toString() || 'https://hub.seaaudit.com/').replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, origin + '/').toString();
const pageTitle = fullTitle || `${title} | ${site.name}`;
const ogImage = `${origin}${href('/og-default.png')}`;
const crumbItems = breadcrumbs?.map((b) => ({ name: b.name, url: new URL(href(b.url), origin + '/').toString() }));
const ld = graph(organization(origin), website(origin), ...(crumbItems ? [crumbs(crumbItems)] : []), ...jsonLd);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const runtime = { adsClient: ads.client, consentMode: ads.consent, ga4: analytics.ga4, base };
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <meta name="theme-color" content="#f6f4ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#081619" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}: ${site.tagline}`} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="manifest" href={href('/site.webmanifest')} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} guides`} href={href('/rss.xml')} />
    <link rel="alternate" type="text/plain" title="LLM summary" href={href('/llms.txt')} />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />

    <script type="application/ld+json" set:html={ld} />

    <script is:inline define:vars={{ runtime }}>
      window.__seahub = runtime;
      document.documentElement.classList.add('js');
      try {
        var t = localStorage.getItem('seahub-theme');
        if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
      } catch (e) {}
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
        window.dataLayer.push(arguments);
      };
      window.gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        wait_for_update: 500,
      });
    </script>
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer showAd={showFooterAd} />
    <SearchDialog />
    <ConsentBanner />
    <script>
      import {
        initReveal,
        initCounters,
        initSpotlight,
        initHeader,
        initTheme,
        initTabs,
        initTimeline,
        initReadingProgress,
        initCopyLinks,
      } from '@/scripts/motion';
      import { initSearch } from '@/scripts/search';
      import { initConsent } from '@/scripts/consent';

      initHeader();
      initTheme();
      initReveal();
      initCounters();
      initSpotlight();
      initTabs();
      initTimeline();
      initReadingProgress();
      initCopyLinks();
      initSearch(window.__seahub.base || '/');
      initConsent();
    </script>
  </body>
</html>
