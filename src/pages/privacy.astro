---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { site } from '@/site.config';
---

<Base
  noindex
  title="Privacy notice"
  description="How ExemptAccommodation.com, published by SEA Audit, collects and uses personal data, including readiness check results, enquiries, analytics and advertising."
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Privacy', url: '/privacy/' },
  ]}
>
  <PageHero
    eyebrow="Privacy"
    title="Privacy notice"
    lede="What we collect, why we collect it and your rights."
  />
  <div class="container">
    <div class="prose">
      <h2>Who we are</h2>
      <p>{site.name} is published by {site.legalName}. For data protection questions, email <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>.</p>

      <h2>What we collect</h2>
      <ul>
        <li>Your settings, such as colour theme and cookie choices, stored in your browser.</li>
        <li>Readiness check answers. These stay in your browser unless you choose to send them to SEA Audit.</li>
        <li>If you send results or an enquiry: your name, email, organisation and the answers you chose to send.</li>
        <li>With your consent: anonymous analytics about how pages are used, and advertising cookies set by Google.</li>
      </ul>

      <h2>Why we use it</h2>
      <ul>
        <li>To reply to enquiries and follow up on readiness check results you send us. The lawful basis is your consent or our legitimate interest in responding to a request you made.</li>
        <li>To understand which guides are useful. The lawful basis is consent.</li>
        <li>To show adverts that fund the site. The lawful basis is consent.</li>
      </ul>

      <h2>How long we keep it</h2>
      <p>Enquiries and results you send are kept for up to two years from our last contact, unless you become a client, in which case our client terms apply.</p>

      <h2>Your rights</h2>
      <p>You can ask for a copy of your data, ask us to correct or delete it, object to how we use it, or withdraw consent at any time. You can also complain to the Information Commissioner's Office.</p>

      <h2>Third parties</h2>
      <p>If advertising and analytics are switched on, Google receives data under its own policies. We do not sell personal data.</p>
    </div>
  </div>
</Base>
