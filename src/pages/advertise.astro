---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/site.config';
import { href } from '@/lib/url';

const placements = [
  { name: 'Leaderboard', where: 'Home page, guide index and the end of every guide', size: 'Responsive, 728x90 and 970x90 on desktop, 320x100 on mobile' },
  { name: 'In-article', where: 'Inside the body of each guide and glossary page', size: 'Responsive native, 300x250 equivalent' },
  { name: 'Sidebar', where: 'Sticky right rail on guides and the regulation tracker', size: '300x250 and 300x600' },
  { name: 'Footer', where: 'Site-wide, above the footer', size: 'Responsive, 728x90 on desktop' },
  { name: 'Featured resource', where: 'Resources directory, labelled as sponsored', size: 'Card with logo, 30 words and a link' },
];
const audience = [
  { icon: 'heart', label: 'Support providers', text: 'Service managers, support workers and operations leads running supported housing.' },
  { icon: 'building', label: 'Housing providers', text: 'Housing associations, charities, CICs and landlords leasing to the sector.' },
  { icon: 'key', label: 'Managing agents', text: 'Agents managing supported housing portfolios for investors and providers.' },
  { icon: 'cpu', label: 'Proptech', text: 'Software and data teams building for housing and care.' },
] as const;
---

<Base
  title="Advertise with us"
  description="Reach support providers, housing providers, managing agents and proptech teams in supported exempt accommodation. Placements, sponsorship and ad rules."
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Advertise', url: '/advertise/' },
  ]}
>
  <PageHero
    eyebrow="Advertise"
    title="Reach the people running supported housing"
    lede={`${site.name} readers make decisions about support services, property, software and compliance. Display placements run through Google AdSense, and we offer direct sponsorship for organisations that serve the sector.`}
    crumbs={[
      { name: 'Home', url: '/' },
      { name: 'Advertise', url: '/advertise/' },
    ]}
  >
    <a href={`mailto:${site.contactEmail}?subject=Advertising%20on%20ExemptAccommodation.com`} class="btn btn-primary reveal mt-8" style="--i:3">
      Ask for the media pack <Icon name="mail" size={16} />
    </a>
  </PageHero>

  <div class="container space-y-20">
    <section aria-labelledby="audience">
      <h2 id="audience" class="text-[2rem]">Who reads {site.name}</h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          audience.map((a, i) => (
            <div class="card reveal p-6" style={`--i:${i}`}>
              <span class="icon-tile">
                <Icon name={a.icon} size={22} />
              </span>
              <h3 class="mt-4 text-[1.2rem]">{a.label}</h3>
              <p class="mt-2 text-[15px] text-muted">{a.text}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="placements">
      <h2 id="placements" class="text-[2rem]">Placements</h2>
      <div class="table-wrap mt-6">
        <table class="w-full overflow-hidden rounded-2xl border border-line bg-card text-left text-[15px]">
          <thead class="bg-paper-2">
            <tr>
              <th class="p-4 font-semibold">Placement</th>
              <th class="p-4 font-semibold">Where it appears</th>
              <th class="p-4 font-semibold">Format</th>
            </tr>
          </thead>
          <tbody>
            {
              placements.map((p) => (
                <tr class="border-t border-line">
                  <td class="p-4 font-semibold">{p.name}</td>
                  <td class="p-4 text-ink-2">{p.where}</td>
                  <td class="p-4 text-ink-2">{p.size}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-[14.5px] text-muted">
        Every placement reserves its space before it loads, so adverts never push content around on the page.
      </p>
    </section>

    <section class="prose" aria-labelledby="rules">
      <h2 id="rules">Our advertising rules</h2>
      <ul>
        <li>Adverts and sponsored content are always labelled.</li>
        <li>Advertisers have no influence over guides, the glossary or the regulation tracker.</li>
        <li>We do not accept adverts that promise guaranteed Housing Benefit rates, high-yield exempt accommodation investments or anything that targets residents.</li>
        <li>Personalised adverts only load for visitors who consent to advertising cookies.</li>
      </ul>
      <h2>Direct sponsorship</h2>
      <p>
        Organisations that serve the sector, such as training providers, software companies, insurers and legal firms, can sponsor a
        featured resource card or a section of the regulation tracker. Sponsored content is marked as sponsored and links use the
        sponsored attribute, so search engines know it is paid. We decide what is published, and we turn down anything that would
        mislead readers about the rules.
      </p>
      <h2>Affiliate partnerships</h2>
      <p>
        We work with a small number of affiliate partners whose products help readers act on a guide, such as compliance
        certificates, landlord insurance, training and housing software. Affiliate links are labelled on the page, carry the sponsored
        attribute and are covered by our <a href={href('/about/#how-we-make-money')}>how we make money</a> statement. If you run an
        affiliate programme for the sector, email us with the commission terms and who the product is for.
      </p>
    </section>
  </div>
</Base>
