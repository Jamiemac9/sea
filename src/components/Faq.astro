---
import Icon from './Icon.astro';

interface Props {
  items: { q: string; a: string }[];
  open?: number;
}
const { items, open = -1 } = Astro.props;
---

<div class="faq">
  {
    items.map((item, i) => (
      <details open={i === open}>
        <summary>
          <span>{item.q}</span>
          <span class="plus" aria-hidden="true">
            <Icon name="plus" size={16} />
          </span>
        </summary>
        <div class="answer">
          <p>{item.a}</p>
        </div>
      </details>
    ))
  }
</div>
