---
import Icon from './Icon.astro';
import { href } from '@/lib/url';

const popular = [
  { t: 'What is exempt accommodation?', u: '/guides/what-is-exempt-accommodation/' },
  { t: 'Licensing and the national standards', u: '/guides/supported-housing-regulatory-oversight-act/' },
  { t: 'Rent and service charges', u: '/guides/housing-benefit-rent-and-service-charges/' },
  { t: 'Grey areas', u: '/guides/grey-areas-in-exempt-accommodation/' },
  { t: 'Audit readiness check', u: '/tools/audit-readiness/' },
];
---

<dialog class="search-dialog" data-search aria-label="Search SEA Hub">
  <div class="flex items-center gap-3 border-b border-line px-5">
    <Icon name="search" size={18} class="text-muted" />
    <input
      type="search"
      class="h-16 w-full bg-transparent text-[17px] outline-none placeholder:text-muted"
      placeholder="Search guides, terms and tools"
      aria-label="Search"
      role="combobox"
      aria-expanded="true"
      aria-controls="search-results"
      autocomplete="off"
    />
    <button type="button" class="grid h-9 w-9 shrink-0 place-items-center rounded-full hover:bg-paper-2" data-search-close aria-label="Close search">
      <Icon name="x" size={16} />
    </button>
  </div>
  <div id="search-results" class="max-h-[52vh] overflow-y-auto p-2" role="listbox" data-search-results>
    <p class="px-4 pb-1 pt-3 text-[12px] font-semibold uppercase tracking-[0.08em] text-muted">Popular</p>
    {
      popular.map((p) => (
        <a class="search-result font-medium" href={href(p.u)}>
          {p.t}
        </a>
      ))
    }
  </div>
  <div class="flex items-center gap-4 border-t border-line px-5 py-3 text-[12.5px] text-muted">
    <span><kbd>Enter</kbd> open</span>
    <span><kbd>&uarr;</kbd> <kbd>&darr;</kbd> move</span>
    <span><kbd>Esc</kbd> close</span>
  </div>
</dialog>
